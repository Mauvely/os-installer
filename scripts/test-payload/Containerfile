# TEST ONLY. The OS image plus sshd and P6's throwaway key for root, so that the
# installed machine can be checked from outside (scripts/verify-installed.sh).
# The app under test is the production build; the test layers add only access
# and, on the installer, the local server (scripts/test-installer/).
# Never ship this image or put it on an ISO that leaves this machine.
ARG BASE=localhost/mauvely-os:spike
FROM ${BASE}
COPY authorized_keys /usr/share/mauvely-p6-test/authorized_keys
RUN printf 'AuthorizedKeysFile .ssh/authorized_keys /usr/share/mauvely-p6-test/authorized_keys\n' \
      > /etc/ssh/sshd_config.d/90-p6-test.conf \
 && systemctl enable sshd && bootc container lint
